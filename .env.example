# Database
DATABASE_PATH=/app/data/ceramica.db

# Session (generate with: openssl rand -hex 32)
SESSION_SECRET=your-session-secret-here-min-32-chars

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR-xxxxx
MP_PUBLIC_KEY=APP_USR-xxxxx
MP_WEBHOOK_SECRET=whsec_xxxxx
MP_SANDBOX=true

# Email Provider (console|resend|smtp)
EMAIL_PROVIDER=console
RESEND_API_KEY=re_xxxxx
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your-password
SMTP_FROM="Cerámica Store <noreply@example.com>"

# App
NODE_ENV=development
BASE_URL=http://localhost:3000